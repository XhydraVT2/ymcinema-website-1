# Rename this file to .env.local for local testing. In Vercel, use
# Project > Settings > Environment Variables and redeploy the site.
# These values are server-only; never use NEXT_PUBLIC_ for manifest tokens.
TMDB_TOKEN=YOUR_TMDB_READ_ACCESS_TOKEN
STREMIO_CLOUD_MANIFEST=YOUR_CLOUD_MANIFEST_JSON_URL
STREMIO_PENGU_MANIFEST=YOUR_PENGU_MANIFEST_JSON_URL
# To remove the Test Stream button and route, set the flag below to false.
ENABLE_TEST_STREAM=true
